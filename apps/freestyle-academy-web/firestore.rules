rules_version = '2';

// Freestyle Academy — user data and subscription entitlements.
//
// Design note for the subscription work: `entitlement` is deliberately NOT
// writable by the client. Only the payment webhook (running with Admin SDK
// privileges in a Cloud Function) may set it. That is what stops a user from
// granting themselves Pro from the browser console, and it is what lets the
// app and the web version read one shared source of truth for the tier.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // The client may write its own progress, but never its entitlement.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['entitlement']);

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['entitlement'])
                    );

      allow delete: if false;
    }

    // Written only by the payment webhook (Admin SDK bypasses these rules).
    match /subscriptions/{docId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
